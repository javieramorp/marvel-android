<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/fragment_characters">

    <fragment
        android:id="@+id/fragment_characters"
        android:name="com.android.marvel.ui.characters.CharactersFragment"
        android:label="@string/characters_title"
        tools:layout="@layout/fragment_characters" >
        <action
            android:id="@+id/action_characters_to_character_detail"
            app:destination="@id/fragment_character_detail" />
        <action
            android:id="@+id/action_characters_to_favorite_characters"
            app:destination="@id/fragment_favorite_characters" />
    </fragment>

    <fragment
        android:id="@+id/fragment_character_detail"
        android:name="com.android.marvel.ui.characterdetail.CharacterDetailFragment"
        android:label="@string/character_detail_title"
        tools:layout="@layout/fragment_character_detail" >
        <argument
            android:name="characterId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/fragment_favorite_characters"
        android:name="com.android.marvel.ui.favoritecharacters.FavoriteCharactersFragment"
        android:label="@string/favorite_characters_title"
        tools:layout="@layout/fragment_favorite_characters" >
        <action
            android:id="@+id/action_favorite_characters_to_character_detail"
            app:destination="@id/fragment_character_detail" />
    </fragment>

</navigation>